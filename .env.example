# Global Configuration
AUTH_REQUIRED=false
USE_MOCKS=true
JWT_SECRET=dev_secret_key_change_in_production

# Frontend Port
FRONTEND_PORT=3000

# Backend Service URLs (Default localhost)
CRM1_URL=http://localhost:5101
CRM2_URL=http://localhost:5102
CRM3_URL=http://localhost:5103
CRM4_URL=http://localhost:5104
CRM5_URL=http://localhost:5105
ERP1_URL=http://localhost:5201
ERP2_URL=http://localhost:5202
ERP3_URL=http://localhost:5203
ERP4_URL=http://localhost:5204
ERP5_URL=http://localhost:5205
ERP6_URL=http://localhost:5206

# Database Connection URLs (PostgreSQL per team database)
# Template: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL_CRM1=postgresql://postgres:postgres@localhost:5432/crm1_db
DATABASE_URL_CRM2=postgresql://postgres:postgres@localhost:5432/crm2_db
DATABASE_URL_CRM3=postgresql://postgres:postgres@localhost:5432/crm3_db
DATABASE_URL_CRM4=postgresql://postgres:postgres@localhost:5432/crm4_db
DATABASE_URL_CRM5=postgresql://postgres:postgres@localhost:5432/crm5_db
DATABASE_URL_ERP1=postgresql://postgres:postgres@localhost:5432/erp1_db
DATABASE_URL_ERP2=postgresql://postgres:postgres@localhost:5432/erp2_db
DATABASE_URL_ERP3=postgresql://postgres:postgres@localhost:5432/erp3_db
DATABASE_URL_ERP4=postgresql://postgres:postgres@localhost:5432/erp4_db
DATABASE_URL_ERP5=postgresql://postgres:postgres@localhost:5432/erp5_db
DATABASE_URL_ERP6=postgresql://postgres:postgres@localhost:5432/erp6_db
