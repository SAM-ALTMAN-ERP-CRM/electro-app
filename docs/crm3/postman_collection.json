                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filter Customers by Type and Query",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/customers?type=corporate&q=Sunrise",
              "host": ["{{base_url}}"],
              "path": ["api", "customers"],
              "query": [
                { "key": "type", "value": "corporate" },
                { "key": "q", "value": "Sunrise" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Filtered results match corporate type\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.every(c => c.type === 'corporate')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Customer by ID (CUST-0002)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/customers/CUST-0002"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns valid customer details with GSTIN\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.eql(\"CUST-0002\");",
                  "    pm.expect(json.data.gstin).to.eql(\"27AABCS1234F1Z5\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Valid Corporate Customer",
