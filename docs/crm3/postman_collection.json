              "mode": "raw",
              "raw": "{\n  \"name\": \"Nexus Global Infotech\",\n  \"type\": \"corporate\",\n  \"email\": \"procurement@nexusglobal.com\",\n  \"phone\": \"9820055555\",\n  \"gstin\": \"27AABCN5555M1Z9\",\n  \"billing_address\": \"1001 Infinity Tower, Mindspace\",\n  \"shipping_address\": \"1001 Infinity Tower, Mindspace\",\n  \"city\": \"Mumbai\"\n}"
