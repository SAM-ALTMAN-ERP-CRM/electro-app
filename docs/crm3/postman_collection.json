                  "pm.test(\"Returns descriptive GSTIN error message\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.include(\"GSTIN\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Validation Failure - Duplicate Email (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Aarav Attempt\",\n  \"type\": \"retail\",\n  \"email\": \"aarav.mehta@example.com\",\n  \"phone\": \"9899999999\",\n  \"city\": \"Mumbai\"\n}"
            },
            "url": "{{base_url}}/api/customers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Returns duplicate email error message\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.include(\"already exists\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Customer Contacts (CUST-0001)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
