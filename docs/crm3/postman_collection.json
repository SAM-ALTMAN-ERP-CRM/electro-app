    {
      "name": "5. Duplicates, Merge & Import (CRM3-D1, D3)",
      "item": [
        {
          "name": "Detect Duplicate Customer Clusters",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/customers/duplicates"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Detects duplicate clusters\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "    pm.expect(json.data.length).to.be.at.least(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Execute Atomic Merge Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"keep_id\": \"CUST-0001\",\n  \"remove_id\": \"CUST-0009\"\n}"
            },
            "url": "{{base_url}}/api/customers/merge"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Merge reports moved contacts and removed customer\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.keep_id).to.eql(\"CUST-0001\");",
                  "    pm.expect(json.data.remove_id).to.eql(\"CUST-0009\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Bulk Customer Import (Valid + Invalid Rows)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customers\": [\n    {\n      \"name\": \"Apex Appliances\",\n      \"type\": \"dealer\",\n      \"email\": \"contact@apex.com\",\n      \"phone\": \"9820088888\",\n      \"gstin\": \"27AABCA8888F1Z4\",\n      \"billing_address\": \"Shop 12 Lamington Road\",\n      \"city\": \"Mumbai\"\n    },\n    {\n      \"name\": \"Invalid Row\",\n      \"type\": \"retail\",\n      \"email\": \"bad-email-address\",\n      \"phone\": \"123\"\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/api/customers/import"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Reports inserted count and error breakdown\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.inserted).to.eql(1);",
                  "    pm.expect(json.data.skipped).to.eql(1);",
                  "    pm.expect(json.data.errors).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
