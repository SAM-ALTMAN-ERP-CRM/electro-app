              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alpha Corporate Without GSTIN\",\n  \"type\": \"corporate\",\n  \"email\": \"alpha@corp.com\",\n  \"phone\": \"9820066666\",\n  \"city\": \"Delhi\"\n}"
