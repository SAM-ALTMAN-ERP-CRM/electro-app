{
  "info": {
    "name": "CRM-3 Customer 360 API Collection",
    "description": "Complete Postman testing suite for CRM-3 microservice endpoints (Port 5103) covering customer master directory, contacts, timeline interactions, dynamic segments, duplicate merges, CSV onboarding, and Section 7 cross-team verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5103",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "mock_jwt_token_crm3_admin",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Service Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service name matches CRM3\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"ok\");",
                  "    pm.expect(json.team).to.eql(\"crm3\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Customers & Contacts (CRM3-A1, A3)",
      "item": [
        {
          "name": "List All Customers",
