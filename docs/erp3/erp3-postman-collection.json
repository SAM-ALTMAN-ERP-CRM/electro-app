{
  "info": {
    "name": "ERP-3 Production & Quality API Collection",
    "description": "Complete Postman testing suite for ERP-3 microservice endpoints (Port 5203) covering Bills of Materials, Manufacturing Work Orders, Material Issuance, QC Inspections, Quality Gate, and Section 7 cross-team verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5203",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "mock_jwt_token_erp3_admin",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Service Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service metadata matches ERP3\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"ok\");",
                  "    pm.expect(json.team).to.eql(\"erp3\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Bill of Materials (BOM)",
      "item": [
        {
          "name": "List All BOMs [ERP3-A1]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/boms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns array of BOMs\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create New BOM [ERP3-A1]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_sku\": \"SKU-0001\",\n  \"version\": 2,\n  \"items\": [\n    { \"component_sku\": \"SKU-0101\", \"qty_per_unit\": 1, \"uom\": \"pcs\" },\n    { \"component_sku\": \"SKU-0102\", \"qty_per_unit\": 1, \"uom\": \"pcs\" },\n    { \"component_sku\": \"SKU-0103\", \"qty_per_unit\": 1, \"uom\": \"pcs\" },\n    { \"component_sku\": \"SKU-0104\", \"qty_per_unit\": 1, \"uom\": \"pcs\" },\n    { \"component_sku\": \"SKU-0105\", \"qty_per_unit\": 1, \"uom\": \"pcs\" }\n  ]\n}"
            },
            "url": "{{base_url}}/api/boms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"BOM created with items\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.id).to.match(/^BOM-/);",
                  "    pm.expect(res.data.items).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get BOM by ID [ERP3-A1]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/boms/BOM-0001"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Contains items array\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.items.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Check Scaled Requirements [ERP3-A3]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/boms/BOM-0001/requirements?qty=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns calculated requirements list\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.target_qty).to.eql(20);",
                  "    pm.expect(res.data.requirements).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Dispatch Purchase Request [ERP3-A3]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-0101\",\n  \"quantity\": 10,\n  \"required_by\": \"2026-11-20\"\n}"
            },
            "url": "{{base_url}}/api/boms/BOM-0001/purchase-request"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Manufacturing Work Orders",
      "item": [
        {
          "name": "List Work Orders [ERP3-B1]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/work-orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns work orders list\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Work Order with Auto Materials [ERP3-B1 & B3]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_sku\": \"SKU-0001\",\n  \"quantity\": 25,\n  \"bom_id\": \"BOM-0001\",\n  \"source\": \"manual\"\n}"
            },
            "url": "{{base_url}}/api/work-orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Materials auto-populated\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.id).to.match(/^WO-/);",
                  "    pm.expect(res.data.materials.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Work Order by ID [ERP3-B1]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/work-orders/WO-0001"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Transition Lifecycle Status [ERP3-B1]",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}"
            },
            "url": "{{base_url}}/api/work-orders/WO-0001/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Issue Material Component [ERP3-C1]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"component_sku\": \"SKU-0101\",\n  \"quantity\": 25,\n  \"issued_by\": \"EMP-0001\"\n}"
            },
            "url": "{{base_url}}/api/work-orders/WO-0001/issue"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Audit issued record returned\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.id).to.match(/^ISS-/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Material Issue History [ERP3-C1]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/work-orders/WO-0001/issues"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Post Finished Goods [ERP3-C3]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/work-orders/WO-0001/post-finished"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Valid response returned\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Quality Control (QC)",
      "item": [
        {
          "name": "List QC Inspections [ERP3-D1]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/qc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Record QC Inspection [ERP3-D1]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wo_id\": \"WO-0001\",\n  \"inspector\": \"EMP-0005\",\n  \"checked_qty\": 50,\n  \"passed_qty\": 50,\n  \"failed_qty\": 0\n}"
            },
            "url": "{{base_url}}/api/qc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Result is pass\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.result).to.eql(\"pass\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get QC Summary & Defect Breakdown [ERP3-D3]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/qc/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Contains pass rate metric\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.overall_pass_rate).to.be.a(\"number\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Check Work Order QC Gate [ERP3-D3]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/work-orders/WO-0001/qc-status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Quality gate returns allowed boolean\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.allowed).to.be.a(\"boolean\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
