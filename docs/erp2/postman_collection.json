{
  "info": {
    "name": "Team ERP-2 (Procurement & Suppliers) API",
    "_postman_id": "erp2-procurement-api-v1",
    "description": "Postman Collection for Team ERP-2 covering Supplier Master, Ratings, Purchase Requests, PO Conversion, Purchase Orders, Over-receiving Validation, and Goods Receipts (GRN).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5202/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "demo_jwt_token",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Suppliers",
      "item": [
        {
          "name": "List Suppliers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/suppliers",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers"]
            }
          }
        },
        {
          "name": "Get Top Rated Suppliers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/suppliers/top?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers", "top"],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Get Supplier by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/suppliers/SUP-0001",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers", "SUP-0001"]
            }
          }
        },
        {
          "name": "Create Supplier",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apex Micro Devices\",\n  \"contact_person\": \"Pooja Hegde\",\n  \"email\": \"pooja@apexmicro.in\",\n  \"phone\": \"+91 98765 43213\",\n  \"address\": \"MIDC Andheri East, Mumbai\",\n  \"category\": \"Passive Components\",\n  \"payment_terms\": \"Net 45\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/suppliers",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers"]
            }
          }
        },
        {
          "name": "Rate Supplier",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 5,\n  \"review\": \"Prompt delivery and high quality components.\",\n  \"rated_by\": \"EMP-0005\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/suppliers/SUP-0001/ratings",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers", "SUP-0001", "ratings"]
            }
          }
        }
      ]
    },
    {
      "name": "Purchase Requests",
      "item": [
        {
          "name": "List Purchase Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/purchase-requests?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-requests"],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Create Purchase Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-0103\",\n  \"product_name\": \"Power supply unit\",\n  \"quantity\": 15,\n  \"requested_by\": \"EMP-0006\",\n  \"department\": \"Assembly\",\n  \"reason\": \"Production order fulfillment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/purchase-requests",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-requests"]
            }
          }
        },
        {
          "name": "Approve Purchase Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"decided_by\": \"EMP-0001\",\n  \"remarks\": \"Approved for order creation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/purchase-requests/PR-0001/decision",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-requests", "PR-0001", "decision"]
            }
          }
        },
        {
          "name": "Convert Request to PO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplier_id\": \"SUP-0001\",\n  \"unit_cost\": 1500.00,\n  \"expected_date\": \"2026-11-28\",\n  \"warehouse_id\": \"WH-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/purchase-requests/PR-0001/convert",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-requests", "PR-0001", "convert"]
            }
          }
        }
      ]
    },
    {
      "name": "Purchase Orders",
      "item": [
        {
          "name": "List Purchase Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/purchase-orders",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-orders"]
            }
          }
        },
        {
          "name": "Get Purchase Order by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/purchase-orders/PO-0002",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-orders", "PO-0002"]
            }
          }
        },
        {
          "name": "Create Purchase Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplier_id\": \"SUP-0001\",\n  \"warehouse_id\": \"WH-01\",\n  \"expected_date\": \"2026-11-30\",\n  \"created_by\": \"EMP-0001\",\n  \"items\": [\n    {\n      \"sku\": \"SKU-0101\",\n      \"product_name\": \"Microcontroller MCU-32\",\n      \"quantity\": 20,\n      \"unit_cost\": 1500.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/purchase-orders",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-orders"]
            }
          }
        },
        {
          "name": "Update PO Status (Send to Supplier)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"sent\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/purchase-orders/PO-0001/status",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-orders", "PO-0001", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Goods Receipts",
      "item": [
        {
          "name": "List Historical Receipts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/goods-receipts",
              "host": ["{{baseUrl}}"],
              "path": ["goods-receipts"]
            }
          }
        },
        {
          "name": "List Pending POs Awaiting Delivery (with Late Flags)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/receipts/pending",
              "host": ["{{baseUrl}}"],
              "path": ["receipts", "pending"]
            }
          }
        },
        {
          "name": "Create Goods Receipt (GRN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"po_id\": \"PO-0002\",\n  \"received_by\": \"EMP-0005\",\n  \"received_on\": \"2026-11-14\",\n  \"notes\": \"Delivery inspected and verified.\",\n  \"items\": [\n    {\n      \"sku\": \"SKU-0102\",\n      \"received_qty\": 3\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/goods-receipts",
              "host": ["{{baseUrl}}"],
              "path": ["goods-receipts"]
            }
          }
        }
      ]
    }
  ]
}
