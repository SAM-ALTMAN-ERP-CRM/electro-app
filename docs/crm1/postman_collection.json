    {
      "name": "7. Section 7 Cross-Team Verifications",
      "item": [
        {
          "name": "Row 1: Read Sales Reps from ERP-6",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5206/api/employees?role_title=Sales%20Rep",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5206",
              "path": ["api", "employees"],
              "query": [
                { "key": "role_title", "value": "Sales Rep" }
              ]
            }
          }
        },
        {
          "name": "Row 2: Read Products from ERP-1",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5201/api/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5201",
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Row 3: Push Sales Order to ERP-4",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quote_id\": \"QUO-0003\",\n  \"customer_id\": \"CUST-0003\",\n  \"sales_rep_id\": \"EMP-0003\",\n  \"items\": [\n    {\n      \"sku\": \"SKU-0003\",\n      \"product_name\": \"65-inch OLED TV\",\n      \"quantity\": 1,\n      \"unit_price\": 94990.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:5204/api/sales-orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5204",
              "path": ["api", "sales-orders"]
            }
          }
        },
        {
          "name": "Row 4: Push Timeline Interaction to CRM-3",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"CUST-0001\",\n  \"type\": \"order\",\n  \"summary\": \"Quote QUO-0001 accepted by customer.\",\n  \"source_team\": \"CRM-1\"\n}"
            },
            "url": {
              "raw": "http://localhost:5103/api/interactions/from-event",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5103",
              "path": ["api", "interactions", "from-event"]
            }
