{
  "info": {
    "name": "CRM-1 Sales Pipeline API Collection",
    "description": "Comprehensive Postman test collection for CRM-1 Sales Pipeline microservice (Port 5101) covering Leads ([CRM1-A1], [CRM1-A3]), Opportunities ([CRM1-B1], [CRM1-B3]), Quotes ([CRM1-C1], [CRM1-C3]), Approvals ([CRM1-D3]), Dealers ([CRM1-D1]), and Section 7 cross-team integration verifications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5101",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "mock_jwt_token_crm1_admin",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Service Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
