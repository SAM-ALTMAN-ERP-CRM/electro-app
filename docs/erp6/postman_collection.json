{
  "info": {
    "name": "ERP-6 HR & Workforce API Collection",
    "description": "Postman v2.1.0 testing collection for Team ERP-6 (Port 5206, erp6_db) covering Health, Departments, Employee Directory, Attendance & Leaves, Payroll, Sales Commissions, Sales Performance Leaderboard, and Section 7 Cross-Team Verification (Rows 1, 5, 27, 28).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5206", "type": "string" },
    { "key": "erp5_url", "value": "http://localhost:5205", "type": "string" },
    { "key": "crm1_url", "value": "http://localhost:5101", "type": "string" },
    { "key": "crm2_url", "value": "http://localhost:5102", "type": "string" },
    { "key": "jwt_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Auth & Health",
      "item": [
        {
          "name": "ERP-6 Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Service is erp6 on port 5206', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.team).to.eql('erp6');",
                  "  pm.expect(Number(json.port)).to.eql(5206);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login via ERP-5 (Row 29 - admin@demo.com)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@demo.com\",\n  \"password\": \"demo123\"\n}"
            },
            "url": {
              "raw": "{{erp5_url}}/api/auth/login",
              "host": ["{{erp5_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('jwt_token', json.data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
